# ==== 构建产物（Makefile / g++，WSL 侧生成） ====
*.o
*.a
*.so
*.out

# 测试与示例可执行文件
# 用通配而不是逐个列举：新增测试用例时不必再回来补这一行
# （原先手写清单漏掉了 test_multithread，构建产物会混进 git status）。
# 注意只锚定仓库根目录，源码在 tests/ 目录下，不会被误伤。
/test_*
/echo_server

# 压测可执行文件
/bench_http_server
/bench_native_http_server

# CMake 构建目录（如改用 CMake）
build/
cmake-build-*/

# ==== 编辑器 / 系统文件 ====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 工作区内部目录（含记忆/审查日志，勿公开）
.workbuddy/

# Windows 编译产物（如在本机 g++/MinGW 编译）
*.exe
*.obj
